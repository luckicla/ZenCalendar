{
  "name": "ZenCalendar",
  "short_name": "ZenCalendar",
  "description": "Tu calendario tranquilito: eventos, tareas y avisos, sincronizados con tu Google Drive.",
  "lang": "es",
  "dir": "ltr",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F7F3FF",
  "theme_color": "#C9B8FF",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nuevo evento", "short_name": "Nuevo", "url": "./index.html?action=new", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Preguntar a la IA", "short_name": "IA", "url": "./index.html?action=ai", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
