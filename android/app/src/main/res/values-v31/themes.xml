<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: la pantalla de arranque usa el icono adaptativo sobre el fondo de la app -->
    <style name="Theme.ZenCalendar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
    </style>
</resources>
