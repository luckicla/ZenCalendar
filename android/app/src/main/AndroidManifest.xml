<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Google Drive y las APIs de IA -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- los avisos -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- avisos a la hora exacta: en Android 12 se pide, en 13+ un calendario lo tiene sin preguntar -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- las alarmas (eventos con «Alarma»): en pantalla completa encima del bloqueo, como un despertador -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- actualizarse desde GitHub (Updater): abrir el instalador de Android con la APK nueva -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- para poder abrir la cámara desde el selector de imágenes (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_zc_pastel"
        android:roundIcon="@mipmap/ic_zc_pastel"
        android:theme="@style/Theme.ZenCalendar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <!-- «Compartir → ZenCalendar»: el texto o la foto van a la IA -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- invitaciones a workspaces: zencalendar://join/#<wid>.<token> (la página docs/w/ lo abre con intent://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zencalendar" android:host="join" />
            </intent-filter>
        </activity>

        <!-- un icono por variante (Ajustes → Icono de la app); solo uno activo a la vez -->
        <activity-alias
            android:name=".Icon_pastel"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_zc_pastel"
            android:roundIcon="@mipmap/ic_zc_pastel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_sakura"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_sakura"
            android:roundIcon="@mipmap/ic_zc_sakura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_menta"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_menta"
            android:roundIcon="@mipmap/ic_zc_menta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_noche"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_noche"
            android:roundIcon="@mipmap/ic_zc_noche">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_cielo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_cielo"
            android:roundIcon="@mipmap/ic_zc_cielo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_melocoton"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_melocoton"
            android:roundIcon="@mipmap/ic_zc_melocoton">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- el del diseño Dot: squircle negro con la «Z» y las pestañas de puntos -->
        <activity-alias
            android:name=".Icon_dot"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot"
            android:roundIcon="@mipmap/ic_zc_dot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dot: fondo blanco y puntos negros -->
        <activity-alias
            android:name=".Icon_dot_blanco"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_blanco"
            android:roundIcon="@mipmap/ic_zc_dot_blanco">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Dot: fondo rojo y puntos blancos -->
        <activity-alias
            android:name=".Icon_dot_rojo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_rojo"
            android:roundIcon="@mipmap/ic_zc_dot_rojo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Dot: un mes de 7×5 puntos con hoy en rojo -->
        <activity-alias
            android:name=".Icon_dot_mes"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_mes"
            android:roundIcon="@mipmap/ic_zc_dot_mes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Dot: una «Z» grande en una pantalla de puntos -->
        <activity-alias
            android:name=".Icon_dot_z"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_z"
            android:roundIcon="@mipmap/ic_zc_dot_z">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Dot: tiras de luz sobre un panel gris -->
        <activity-alias
            android:name=".Icon_dot_glyph"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_glyph"
            android:roundIcon="@mipmap/ic_zc_dot_glyph">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Dot: «24» en cifras de puntos bajo una cabecera roja -->
        <activity-alias
            android:name=".Icon_dot_reloj"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_zc_dot_reloj"
            android:roundIcon="@mipmap/ic_zc_dot_reloj">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- los avisos: suenan aunque la app esté cerrada, y vuelven tras reiniciar -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <!-- la alarma en pantalla completa (AlarmReceiver.showAlarm → setFullScreenIntent) -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.luckicla.zencalendar.alarm"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.ZenCalendar.Alarm" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- workspaces: mirar cada ~15 min si otros han cambiado algo (JobScheduler, Workspaces.java) -->
        <service
            android:name=".WsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- widgets -->
        <receiver android:name=".AgendaWidget" android:exported="true" android:label="@string/widget_agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_info" />
        </receiver>
        <receiver android:name=".TodayWidget" android:exported="true" android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".NextWidget" android:exported="true" android:label="@string/widget_next">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver android:name=".MonthWidget" android:exported="true" android:label="@string/widget_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_month_info" />
        </receiver>
        <!-- «¿Qué enseña este widget?»: al ponerlo, al mantenerlo pulsado → Configurar y desde Ajustes -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ZenCalendar.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".AgendaWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- la foto hecha con la cámara para el selector de imágenes, y la APK de las actualizaciones -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
