<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Lo siguiente»: el próximo evento en grande (hora, título y cuánto falta).
     Sirve para Zen y Dot: en Dot se enseñan la rejilla y la hora en ZenDot (time_img); en Zen, time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wbg_24"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:scaleType="fitXY"
        android:src="@drawable/wgrid"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/bar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:src="@drawable/wdot"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/fg"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/time_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/fg"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top">
            <ImageView
                android:id="@+id/add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wplus"
                android:contentDescription="@string/add" />
            <TextView
                android:id="@+id/add_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/fg" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
